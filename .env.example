# Copy to .env and adjust if needed. No secrets are required in week 1:
# KRS, VAT White List and OpenSanctions bulk files are public and keyless.

# Root directory of the local data lake (bronze/silver/gold/quality/state)
KYB_DATA_DIR=data

# Logging level: DEBUG, INFO, WARNING, ERROR
KYB_LOG_LEVEL=INFO

